# Site
NEXT_PUBLIC_BASE_URL=https://sovinc.com
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_CONTACT_WEBHOOK_URL=

# Business card QR code (sovinc.com/start) - server-side only, do not prefix with NEXT_PUBLIC_
# Where /start redirects to: an absolute http(s) URL or a site path. Falls back to "/" when empty.
QR_REDIRECT_URL=https://www.linkedin.com/in/your-profile
# n8n webhook that logs each scan (POST /webhook/sovinc-qr-scan). Logging is skipped when empty.
QR_WEBHOOK_URL=https://your-n8n-host/webhook/sovinc-qr-scan
# Header Auth value of the n8n webhook, sent as the X-Webhook-Secret header
QR_WEBHOOK_SECRET=
